{
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"extract-i18n": "i18next -c i18next-parser.config.cjs",
		"gen:api": "cargo run --manifest-path ../api/Cargo.toml -p server --example dump_openapi -- src/data/openapi.json && openapi-typescript src/data/openapi.json -o src/data/api.types.ts",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.5.0",
		"@mui/material": "^9.5.0",
		"i18next": "^27.1.3",
		"i18next-browser-languagedetector": "^8.3.0",
		"js-yaml": "^5.5.0",
		"locale-code": "^2.0.2",
		"lz-string": "^1.5.0",
		"preact": "^11.2.0",
		"preact-router": "^4.1.2",
		"react-helmet-async": "^3.1.0",
		"react-i18next": "^18.0.3"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"i18next-parser": "^9.4.0",
		"openapi-typescript": "^6.7.6",
		"prettier": "^3.10.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8"
	}
}